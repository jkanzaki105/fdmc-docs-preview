---
layout: null
---
{% for ref in site.data.references %}@article{ {{ ref.key }},
    author = "{{ ref.author }}",
    title = "{ {{ ref.title }} }",
    eprint = "{{ ref.eprint }}",
    archivePrefix = "{{ ref.archivePrefix }}",
{% if ref.primaryClass %}    primaryClass = "{{ ref.primaryClass }}",{% endif %}
{% if ref.reportNumber %}    reportNumber = "{{ ref.reportNumber }}",{% endif %}
    doi = "{{ ref.doi }}",
    journal = "{{ ref.journal }}",
    volume = "{{ ref.volume }}",
{% if ref.number %}    number = "{{ ref.number }}",{% endif %}
    pages = "{{ ref.pages }}",
    year = "{{ ref.year }}"
}
{% endfor %}